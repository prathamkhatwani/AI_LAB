# AI Tic-Tac-Toe
# Human = X
# Computer = O
# AI uses Minimax algorithm

board = [" " for _ in range(9)]


# Display the board
def display_board():
    print()
    print(" " + board[0] + " | " + board[1] + " | " + board[2])
    print("---+---+---")
    print(" " + board[3] + " | " + board[4] + " | " + board[5])
    print("---+---+---")
    print(" " + board[6] + " | " + board[7] + " | " + board[8])
    print()


# Check whether a player has won
def check_winner(player):
    winning_positions = [
        [0, 1, 2],
        [3, 4, 5],
        [6, 7, 8],
        [0, 3, 6],
        [1, 4, 7],
        [2, 5, 8],
        [0, 4, 8],
        [2, 4, 6]
    ]

    for position in winning_positions:
        if (board[position[0]] == player and
            board[position[1]] == player and
            board[position[2]] == player):
            return True

    return False


# Check whether the board is full
def board_full():
    return " " not in board


# Minimax algorithm
def minimax(is_ai_turn):
   
    # AI wins
    if check_winner("O"):
        return 10

    # Human wins
    if check_winner("X"):
        return -10

    # Draw
    if board_full():
        return 0

    # AI's turn - maximize score
    if is_ai_turn:
        best_score = -float("inf")

        for i in range(9):
            if board[i] == " ":
                # Try AI move
                board[i] = "O"

                # Look at the result
                score = minimax(False)

                # Undo move
                board[i] = " "

                # Choose maximum score
                best_score = max(best_score, score)

        return best_score

    # Human's turn - minimize score
    else:
        best_score = float("inf")

        for i in range(9):
            if board[i] == " ":
                # Try human move
                board[i] = "X"

                # Look at the result
                score = minimax(True)

                # Undo move
                board[i] = " "

                # Choose minimum score
                best_score = min(best_score, score)

        return best_score


# Find the best move for the AI
def computer_move():
    best_score = -float("inf")
    best_move = None

    for i in range(9):
        if board[i] == " ":

            # Try this move
            board[i] = "O"

            # Calculate how good this move is
            score = minimax(False)

            # Undo the move
            board[i] = " "

            # Keep the best move
            if score > best_score:
                best_score = score
                best_move = i

    # Make the best move
    board[best_move] = "O"


# Main game
print("TIC-TAC-TOE")
print("You are X")
print("Computer is O")

print("\nPositions:")
print("1 | 2 | 3")
print("--+---+--")
print("4 | 5 | 6")
print("--+---+--")
print("7 | 8 | 9")

while True:

    # Human move
    try:
        choice = int(input("\nEnter your position (1-9): "))
    except ValueError:
        print("Please enter a number from 1 to 9.")
        continue

    # Check valid position
    if choice < 1 or choice > 9:
        print("Invalid position. Choose between 1 and 9.")
        continue

    # Check whether position is occupied
    if board[choice - 1] != " ":
        print("Position already occupied. Choose another position.")
        continue

    # Make human move
    board[choice - 1] = "X"

    display_board()

    # Check human winner
    if check_winner("X"):
        print("Congratulations! You won!")
        break

    # Check draw
    if board_full():
        print("Game is a draw!")
        break

    # AI move
    print("Computer is thinking...")
    computer_move()

    print("Computer's move:")
    display_board()

    # Check AI winner
    if check_winner("O"):
        print("Computer wins!")
        break

    # Check draw
    if board_full():
        print("Game is a draw!")
        break
